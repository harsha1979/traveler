# Copy this file to .env and fill in real values. Never commit the real .env.

# --- HTTP server ---
PORT=4000
# Comma-separated list of allowed browser origins (your frontend's URL(s))
CORS_ORIGIN=http://localhost:5757

# --- MySQL (local dev or AWS RDS) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wayfare_app
DB_PASSWORD=changeme
DB_NAME=wayfare

# Number of days of flight availability the seed script generates
SEED_DAYS=90

# --- ThunderID (IdP) ---
# Base URL of the ThunderID instance issuing access tokens for this app.
THUNDERID_BASE_URL=https://default-idp.amp.18.217.217.55.sslip.io
THUNDERID_USERINFO_PATH=/oauth2/userinfo
THUNDERID_TOKEN_PATH=/oauth2/token
# Only needed if the ThunderID application was registered as a
# *confidential* client (requires client_secret_post/basic). Leave unset
# for a public/PKCE client - that's the recommended setup, since this
# app already implements PKCE. If set, this stays server-side only; the
# frontend (js/config.js) never sees or sends it.
THUNDERID_CLIENT_SECRET=

# --- travel-api contract (for the future booking-agent/MCP project) ---
# Shared service credential the future traveler-mcp/flights-mcp servers
# send as `Authorization: Bearer <TRAVEL_API_KEY>` to use the
# /travelers/*, /flights/search, /bookings endpoints. Matches that
# project's own TRAVEL_API_KEY env var name so it can point straight at
# this server via TRAVEL_API_URL=http://<this-host>:4000.
# Generate a real random value, e.g.: openssl rand -hex 32
TRAVEL_API_KEY=replace-with-a-long-random-value
